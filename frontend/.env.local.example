# Copy to .env.local (gitignored — see .gitignore's `*.local` rule) and
# adjust if the backend isn't reachable on the default port 8000, e.g.
# because something else on your machine already holds it. Only used by
# vite.config.js's dev proxy — irrelevant once VITE_API_BASE_URL is set.
VITE_BACKEND_PORT=8000

# Leave unset for local dev — src/api.js then uses relative paths through
# the Vite dev proxy above. Set this in a deployed build (e.g. Vercel's
# project env vars) to the full deployed backend URL, no trailing slash,
# e.g. https://your-backend-name.onrender.com — src/api.js then calls the
# backend directly, and the backend's ALLOWED_ORIGIN must include this
# frontend's deployed URL for CORS to allow it.
# VITE_API_BASE_URL=https://your-backend-name.onrender.com
